# ===============================================
# TEMPLATE .ENV UNTUK SERVER HOSTING 
# Update nilai-nilai di bawah sesuai dengan hosting Anda
# ===============================================

APP_NAME="Portal Desa Kadun Jaya"
APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false
APP_URL=https://kadunjaya.kampungku.online

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===============================================
# DATABASE CONFIGURATION - UPDATE THESE!
# ===============================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u818788320_portaldesa
DB_USERNAME=u818788320_portaldesa
DB_PASSWORD=your_actual_database_password_here

# ===============================================
# ALTERNATIVE DATABASE HOSTS (try if localhost fails)
# ===============================================
# DB_HOST=127.0.0.1
# DB_HOST=sql.your-hosting-provider.com

# ===============================================
# BROADCASTING, CACHE, QUEUE, SESSION
# ===============================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ===============================================
# MEMCACHED & REDIS (if available on hosting)
# ===============================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===============================================
# MAIL CONFIGURATION (update for production)
# ===============================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===============================================
# AWS (if using AWS services)
# ===============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===============================================
# PUSHER (if using real-time features)  
# ===============================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ===============================================
# HOSTING SPECIFIC SETTINGS
# ===============================================
# Some hosting providers require these
ASSET_URL=https://kadunjaya.kampungku.online
MIX_ASSET_URL=https://kadunjaya.kampungku.online

# ===============================================
# INSTRUCTIONS:
# ===============================================
# 1. Copy this file to .env in your server root directory
# 2. Update DB_DATABASE, DB_USERNAME, DB_PASSWORD with actual values
# 3. Generate APP_KEY: php artisan key:generate
# 4. Update APP_URL with your actual domain
# 5. Set APP_DEBUG=false for production
# 6. Update MAIL settings if sending emails
# ===============================================
